# PostgreSQL connection string (async psycopg driver).
#
# LOCAL DEVELOPMENT:
#   DATABASE_URL=postgresql+psycopg://localhost/qrgenerator
#
# PRODUCTION (Vercel) — use the Supabase Transaction Pooler connection string:
#   Find it in: Supabase Dashboard → Project → Settings → Database → Connection string → Transaction pooler
#   DATABASE_URL=postgresql+psycopg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# Set DATABASE_URL in Vercel project → Settings → Environment Variables (Production).
# Never commit the production value here.
DATABASE_URL=postgresql+psycopg://localhost/qrgenerator

# Root that contains output/holder and output/tools.
# Defaults to the desktop app's folder so both apps share one output tree.
QR_OUTPUT_ROOT=../3DQRGenerator

# Path to the compiled C++ engine CLI
QR_ENGINE_BIN=../engine/build/bin/qr_engine

# Seconds before an engine call is treated as hung
QR_ENGINE_TIMEOUT=120

# Origin of the deployed Tools Management 2 frontend. Used to build the FastAPI
# CORS allow-list. Comma-separate if you have more than one (custom domain +
# vercel.app alias). On Vercel this must be set in Production, otherwise the
# browser blocks the frontend's requests and it reports the backend as
# unreachable. Leave unset for `next dev` (localhost:3000 is allowed already).
# FRONTEND_URL=https://<your-frontend>.vercel.app

# Supabase REST credentials. Required by the duplicate-ID check and the record
# insert in POST /api/batches/{batchId}/objects. Without them object creation
# fails with "supabase_insert_failed".
# On Vercel set both in Production; never commit the real values.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
